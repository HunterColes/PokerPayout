<?xml version="1.0" encoding="utf-8"?>
<!--
   Android's own backup of the app's data (Android 12 and up; backup_rules.xml is the same for older
   versions). It takes what the in-app backup file takes (core/backup/BackupCatalog.kt): every
   SharedPreferences file, so presets, History, the chip set, settings and tonight's game, plus any
   file a later version keeps in its files folder. The cache (a preset just shared) is never taken.

   Nothing in it is a secret: the app has no accounts, passwords or keys. It does hold the players'
   names, so the copy in Google's cloud is made only when it is end-to-end encrypted (the phone has a
   screen lock). Moving to a new phone by cable or Wi-Fi takes everything else.

   What's about this phone alone stays on it, in the cloud and in a move (PP-137): phone_prefs, the
   music's picked songs, which are this phone's file loans and can't play on another one, and whether
   this phone shows the welcome (PP-113: a restored phone's data says it isn't new to the app)
   (BackupCatalog.PHONE_FILES; AndroidBackupRulesTest checks every one is left out of each). Whether
   to ask for notifications isn't saved at all: the app asks Android each time, so a new phone asks.
   See https://developer.android.com/about/versions/12/backup-restore
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <exclude domain="sharedpref" path="phone_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <exclude domain="sharedpref" path="phone_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
